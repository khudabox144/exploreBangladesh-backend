generator client {
  // 💡 The 'output' property belongs HERE
  provider = "prisma-client-js" // Use prisma-client-js, not just prisma-client
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  // ❌ REMOVE 'output' FROM HERE! (Lines 13-15 in your error output)
  url      = env("DATABASE_URL")
}

// Prisma schema for a Tour booking application
// Models: User, Tour, Location, ItineraryItem, Booking, Review, Image, Category, Operator, PriceOption

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String?
  role      String    @default("USER")
  bookings  Booking[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Operator {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  website     String?
  tours       Tour[]
}

model Location {
  id        Int    @id @default(autoincrement())
  name      String
  country   String
  latitude  Float?
  longitude Float?
  tours     Tour[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  tours Tour[]
}

model Tour {
  id           Int             @id @default(autoincrement())
  title        String
  slug         String          @unique
  description  String?
  durationDays Int
  difficulty   String?
  capacity     Int?
  startDate    DateTime?
  endDate      DateTime?
  currency     String          @default("USD")
  basePrice    Float
  operator     Operator?       @relation(fields: [operatorId], references: [id])
  operatorId   Int?
  location     Location?       @relation(fields: [locationId], references: [id])
  locationId   Int?
  images       Image[]
  itineraries  ItineraryItem[]
  priceOptions PriceOption[]
  categories   Category[]
  reviews      Review[]
  bookings     Booking[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ItineraryItem {
  id      Int     @id @default(autoincrement())
  tour    Tour    @relation(fields: [tourId], references: [id])
  tourId  Int
  day     Int
  title   String
  details String?
}

model PriceOption {
  id       Int    @id @default(autoincrement())
  tour     Tour   @relation(fields: [tourId], references: [id])
  tourId   Int
  name     String
  price    Float
  currency String @default("USD")
}

model Image {
  id     Int     @id @default(autoincrement())
  url    String
  alt    String?
  tour   Tour?   @relation(fields: [tourId], references: [id])
  tourId Int?
}

model Booking {
  id         Int           @id @default(autoincrement())
  user       User          @relation(fields: [userId], references: [id])
  userId     Int
  tour       Tour          @relation(fields: [tourId], references: [id])
  tourId     Int
  seats      Int           @default(1)
  totalPrice Float
  currency   String        @default("USD")
  status     BookingStatus @default(PENDING)
  bookedAt   DateTime      @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  tour      Tour     @relation(fields: [tourId], references: [id])
  tourId    Int
  rating    Int
  title     String?
  text      String?
  createdAt DateTime @default(now())
}
